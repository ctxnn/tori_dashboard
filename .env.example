# Copy to .env.local. Every value is optional for a local demo.

# Signs the demo-role session cookie. Set a long random value anywhere shared.
SESSION_SECRET=change-me-to-a-long-random-string

# Shared secret the payment simulator signs webhook events with.
SIMULATOR_WEBHOOK_SECRET=change-me-too

# Payment provider adapter. Only "simulator" ships with the prototype.
PAYMENT_PROVIDER=simulator

# Optional: enables the Claude-powered brief assistant (claude-opus-5-5).
# Without it, the assistant uses Torii's built-in offline templates.
# ANTHROPIC_API_KEY=sk-ant-...
# TORII_AI=off            # force the offline assistant even with a key

# Where the SQLite database and uploaded artwork live (default: ./data).
# TORII_DATA_DIR=./data

# Set to "off" to disable the "Reset demo" button on a shared deployment.
# DEMO_RESET=off

# Pin the clock (ISO timestamp) — useful for rehearsing a demo on a fixed date.
# TORII_NOW=2026-10-21T09:00:00Z

# --- Fan app and Partner Portal ---
# Signs fan-app and Partner Portal cookies. Defaults to SESSION_SECRET.
# AUTH_SECRET=change-me
# Signs book and figure authenticity codes (T1-…). The seeded demo codes match the default;
# if you change it, run `npm run store:seed` and use the codes it prints.
# TAG_SECRET=dev-tag-secret-change-me
# Optional Razorpay TEST keys. Without them the fan app uses its built-in mock UPI checkout.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...

